# Public frontend API base. This contains no credentials.
#
# Development: keep /api so Vite proxies requests to the local backend.
#   VITE_API_BASE_URL=http://localhost:5100/api
#
# Production (Render Static Site): point at the deployed backend web
# service. Set the actual backend URL in Render's environment (do not
# hardcode it in the repository).
#   VITE_API_BASE_URL=https://<backend-render-service>.onrender.com/api
VITE_API_BASE_URL=http://localhost:5100/api
