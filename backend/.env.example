# CrisisFlow AI - Backend environment configuration
# Copy this file to .env and fill in your values.

# --- Core ---
PORT=5000
NODE_ENV=development

# --- Database ---
# IMPORTANT: MongoDB database names must not contain spaces or
# URL-encoded characters. Use a plain name such as crisisflow.
MONGODB_URI=mongodb://localhost:27017/crisisflow

# --- CORS ---
# Frontend origin allowed by CORS in development
FRONTEND_URL=http://localhost:5173

# --- Google Maps (Phase 5) ---
# Server-side only. NEVER expose this key to the React frontend.
# Enables Google Places API and Google Routes API integrations in
# findFacilities / calculateRoute. If left empty, the Maps-based
# endpoints return "Maps service is not configured".
#
# Google Cloud Console: create a key and enable the Places API and
# Routes API for the project.
GOOGLE_MAPS_API_KEY=

# --- ASI:One (Phase 6) ---
# Server-side only. NEVER expose this key to the React frontend.
# Enables ASI:One AI integration for intent understanding via /api/ai/understand.
# If left empty, the /api/ai/understand endpoint returns
# "AI service is not configured".
#
# ASI:One portal: obtain an API key for your workspace.
ASI_ONE_API_KEY=
# ASI:One exposes an OpenAI-compatible Chat Completions endpoint.
# These match the live API defaults and can be overridden if needed.
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1

# --- ACP (Phase 8) ---
# Agent Communication Protocol interface. This is a protocol layer and
# requires no credentials. Only the stable agent identifier presented by
# the CrisisFlow agent over ACP is configurable (optional).
ACP_AGENT_ID=crisisflow-agent

# --- Agentverse (Phase 9) ---
# The official Agentverse SDK currently documents FastAPI/uagents_core (not
# Node/Express).  Run agentverse_adapter/main.py alongside this backend; it
# implements the signed Chat Protocol and forwards only allow-listed requests
# to POST /api/acp. These values are optional and do not affect /api/acp.
#
# 1. Get an API key at https://agentverse.ai (profile -> API keys).
# 2. Register: Agentverse -> Launch an Agent -> Connect Agent -> FastAPI,
#    then provide the public adapter endpoint and keywords.
# 3. Agentverse generates the agent URI/address; copy it here.
AGENTVERSE_API_KEY=
AGENT_URI=
# Stable seed phrase associated with the agent identity (never commit/log).
AGENT_SEED_PHRASE=
# Public base URL where the FastAPI adapter is deployed (no trailing slash).
AGENT_EXTERNAL_ENDPOINT=
# Private URL reachable from the adapter. Keep at localhost/private network.
CRISISFLOW_BACKEND_URL=http://127.0.0.1:5000

# ============================================================
# Reserved for FUTURE phases. Tavily / web search are intentionally not
# integrated yet.
# ============================================================
# TAVILY_API_KEY=
