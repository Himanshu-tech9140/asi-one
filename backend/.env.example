# CrisisFlow AI - Backend environment configuration
# Copy this file to .env and fill in your values.

# --- Core ---
# Render provides PORT automatically; do NOT set it manually in production.
NODE_ENV=development

# --- Database ---
# Production REQUIRES MONGODB_URI (set in Render). Development may leave it
# blank to fall back to mongodb://localhost:27017/crisisflow, or set a real URI.
MONGODB_URI=

# --- CORS ---
# Frontend origin allowed by CORS.
# Development default: http://localhost:5173
# Production REQUIRES FrontEndUrl = the deployed Render Static Site URL.
FRONTEND_URL=http://localhost:5173

# --- Google Maps (Phase 5) ---
# Server-side only. NEVER expose this key to the React frontend.
# Production REQUIRES this key; without it facility search fails clearly
# instead of falling back to mock data.
GOOGLE_MAPS_API_KEY=

# --- ASI:One (Phase 6) ---
# Server-side only. NEVER expose this key to the React frontend.
# Production REQUIRES this key; without it AI planning fails clearly instead
# of simulating responses.
ASI_ONE_API_KEY=
# ASI:One exposes an OpenAI-compatible Chat Completions endpoint.
# These match the live API defaults and can be overridden if needed.
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1

# --- ACP (Phase 8) ---
# Agent Communication Protocol interface. This is a protocol layer and
# requires no credentials. Only the stable agent identifier presented by
# the CrisisFlow agent over ACP is configurable (optional).
ACP_AGENT_ID=crisisflow-agent

# --- Agentverse (Phase 9) ---
# Optional. See AGENTVERSE_README.md for configuration.
AGENTVERSE_API_KEY=
AGENT_URI=
AGENT_SEED_PHRASE=
AGENT_EXTERNAL_ENDPOINT=
CRISISFLOW_BACKEND_URL=http://127.0.0.1:5000
